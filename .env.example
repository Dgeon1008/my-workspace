# Relative paths resolve from the project root.
WORKSPACE_DB_PATH=./data/workspace.sqlite
# Local FastAPI service used by the Trading App module.
NEXT_PUBLIC_TRADING_API_URL=http://127.0.0.1:8000
# Shared live project server, used by both Craft Anything and Moa.
MOA_SEMANTLE_PORT=4175
MOA_GOMOKU_PORT=4176
MOA_2048_PORT=4177
MOA_EARTH_EXPLORER_PORT=4178
# Optional upstream for Semantle daily puzzles and guesses.
# SIMILARITY_SERVICE_URL=https://semantle-ko.newsjel.ly
# Automatic account usage refresh while the page is open (minimum 15 seconds).
TOKEN_SYNC_INTERVAL_SECONDS=60
# Optional: absolute path to the installed official codex.exe, if not in PATH.
# CODEX_EXECUTABLE=C:/path/to/codex.exe
# Advanced JSON argument array for an app-server wrapper; normally omit.
# CODEX_APP_SERVER_ARGS=["app-server"]
